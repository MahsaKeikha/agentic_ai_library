BT 1 0 0 1 0 497.5 Tm /F4 6.5 Tf 8.4 TL (    "synthetic://f117/motor-anomaly/v1"}) Tj T*  T*  T* (def test_anomaly_recommends_protected_stop_without_command\(\):) Tj T* (    result = run_twin\(anomaly_case\(\), now=NOW\)) Tj T* (    assert result.state["condition"] == "TRIP_THRESHOLD_EXCEEDED") Tj T* (    assert result.recommendation["action"] == "controlled_stop_and_inspection") Tj T* (    assert result.status == "AWAITING AUTHORIZED ENGINEER APPROVAL") Tj T* (    assert result.governance["command_issued"] is False) Tj T* (    assert result.governance["execution_blocked"] is True) Tj T*  T*  T* (def test_authorized_approval_records_next_step_but_still_issues_no_command\(\):) Tj T* (    case = anomaly_case\(\)) Tj T* (    case["approval"] = {"approved": True, "role": "authorized_engineer", "approver":) Tj T* (    "Demo Engineer", "procedure_reference": "DEMO-SOP-017"}) Tj T* (    result = run_twin\(case, now=NOW\)) Tj T* (    assert result.status == "AUTHORIZED FOR SITE PROCEDURE - NO COMMAND ISSUED") Tj T* (    assert result.governance["approval_valid"] is True) Tj T* (    assert result.governance["command_issued"] is False) Tj T*  T*  T* (def test_incomplete_or_wrong_role_approval_fails_closed\(\):) Tj T* (    case = anomaly_case\(\)) Tj T* (    case["approval"] = {"approved": True, "role": "operator", "approver": "Demo"}) Tj T* (    assert run_twin\(case, now=NOW\).governance["execution_blocked"] is True) Tj T*  T*  T* (def test_missing_sensor_contract_is_rejected\(\):) Tj T* (    case = anomaly_case\(\)) Tj T* (    del case["vibration_mm_s"]) Tj T* (    with pytest.raises\(TwinInputError, match="Missing telemetry fields"\):) Tj T* (        run_twin\(case, now=NOW\)) Tj T*  T*  T* (def test_stale_telemetry_is_rejected\(\):) Tj T* (    case = anomaly_case\(\)) Tj T* (    case["observed_at"] = \(NOW - timedelta\(minutes=5\)\).isoformat\(\)) Tj T* (    with pytest.raises\(TwinInputError, match="stale"\):) Tj T* (        run_twin\(case, now=NOW\)) Tj T*  T*  T* (def test_nominal_state_remains_decision_support_only\(\):) Tj T* (    case = anomaly_case\(\)) Tj T* (    case.update\(temperature_c=58.0, vibration_mm_s=2.0, current_a=20.0\)) Tj T* (    result = run_twin\(case, now=NOW\)) Tj T* (    assert result.state["condition"] == "NOMINAL") Tj T* (    assert result.recommendation["action"] == "continue_and_monitor") Tj T* (    assert result.governance["protected_action"] is False) Tj T* (    assert result.status == "DECISION SUPPORT COMPLETE") Tj T*  T*  T* (def test_simulations_and_trace_are_reproducible\(\):) Tj T* (    first = run_twin\(anomaly_case\(\), now=NOW\).to_dict\(\)) Tj T* (    second = run_twin\(anomaly_case\(\), now=NOW\).to_dict\(\)) Tj T* (    assert first == second) Tj T* (    assert [item["option"] for item in first["simulations"]] == ["continue_and_monitor",) Tj T* (    "derate_to_70_percent", "controlled_stop_and_inspection"]) Tj T* (    assert [event["sequence"] for event in first["trace"]] == [1, 2, 3, 4, 5]) Tj T* (    assert all\(event["evidence"] for event in first["trace"]\)) Tj T* ET
