.090196 .196078 .301961 rg
BT 1 0 0 1 0 85.9 Tm /F4 6.5 Tf 8.4 TL (def run_system\(case, approve=False\):) Tj T* (    state = SharedState.from_case\(case\)) Tj T* (    for agent in execution_plan:) Tj T* (        result = agent.analyze\(case, state\)) Tj T* (        state.record\(result\)) Tj T* (        if result.has_blocker:) Tj T* (            return state.finish\("REVIEW REQUIRED"\)) Tj T* (    evaluation = evaluator.score\(state\)) Tj T* (    if not evaluation.passed:) Tj T* (        return state.finish\("EVALUATION BLOCKED"\)) Tj T* (    return gatekeeper.review\(state, approve=approve\)) Tj T* ET
